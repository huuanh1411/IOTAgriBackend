<?xml version="1.0" encoding="utf-8"?>
<!--
  File nay danh cho qua trinh PHAT TRIEN khi backend chay HTTP (khong TLS)
  o dev, vi mac dinh tu Android 9 (API 28) tro len chan cleartext traffic.

  Cach dung:
  1. Sau khi chay `flutter create .` de sinh thu muc android/, copy file
     nay vao: android/app/src/main/res/xml/network_security_config.xml
  2. Trong android/app/src/main/AndroidManifest.xml, o the <application>,
     them thuoc tinh:
       android:networkSecurityConfig="@xml/network_security_config"
       android:usesCleartextTraffic="true"

  KHONG dung cau hinh nay cho ban build production - luc do hay dam bao
  API_BASE_URL tro toi HTTPS that su (backend appsettings.json cung da
  cau hinh Mqtt/Server dung TLS cho production).
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">localhost</domain>
        <!-- Them dia chi IP LAN cua may chay backend khi test tren thiet bi that, vi du: -->
        <!-- <domain includeSubdomains="true">192.168.1.10</domain> -->
    </domain-config>
</network-security-config>
